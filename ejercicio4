#include <iostream>
using namespace std;


int main(){
int numero1, numero2, diferencia;

cout << "Ingresar primer numero: ";
cin >> numero1;
cout << "Ingresar segundo numero: ";
cin >> numero2;

if (numero1 > numero2){
    diferencia = numero1 - numero2;
}else{
    diferencia = numero2 - numero1;
}

cout << "La diferencia es: " << diferencia;

return 0;
}
